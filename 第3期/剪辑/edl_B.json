     ],
     "text": "我们人就可以把AI",
     "hl": [],
     "exact": true
    },
    {
     "spk": "wu",
     "src": [
      612.97,
      620.1
     ],
     "text": "当作一个非常厉害的工具，人是负责提供方向和直接判断的，这才是我们用AI最好的方式。",
     "hl": [
      "提供方向"
     ],
     "exact": true
    }
   ]
  },
