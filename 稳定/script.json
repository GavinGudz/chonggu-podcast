{
 "ref": "voice/ref_b.wav",
 "ref_text": "那么学历给我带来的是机会，大学给我带来的是朋友，那么从此之后，学习给我带来的是行动，还有选择。",
 "gap": 0.45,
 "lines": [
  {
   "id": "q1",
   "scene": "two",
   "text": "我会问自己：伴侣之间的关系，真的会长期稳定吗？",
   "gap": 0.7
  },
  {
